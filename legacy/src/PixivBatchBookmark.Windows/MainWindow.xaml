<Window x:Class="PixivBatchBookmark.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Pixiv 批量收藏 · Windows 1.0.4" Icon="pack://application:,,,/PixivBatchBookmark;component/Assets/AppIcon.ico" Width="1460" Height="900" MinWidth="1000" MinHeight="740" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
 <Grid Background="#F8F0E2">
  <!-- Preserve the supplied wallpaper proportions; keep the controls over a readable warm background. -->
  <Image x:Name="WallpaperImage" Source="pack://application:,,,/PixivBatchBookmark;component/Assets/Wallpaper.png" Stretch="Uniform" HorizontalAlignment="Right" IsHitTestVisible="False" Panel.ZIndex="0" />
  <Rectangle x:Name="WallpaperShade" IsHitTestVisible="False" Panel.ZIndex="1">
   <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFF8F0E2" Offset="0"/><GradientStop Color="#FFF8F0E2" Offset="0.53"/><GradientStop Color="#00F8F0E2" Offset="0.75"/></LinearGradientBrush></Rectangle.Fill>
  </Rectangle>
 <Grid x:Name="InterfacePanel" Margin="28,82,28,22" Width="850" HorizontalAlignment="Left" Panel.ZIndex="2">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.05*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Margin="0,0,0,18">
   <StackPanel><TextBlock Text="Pixiv 批量收藏" FontSize="28" FontWeight="SemiBold" Foreground="#14283F"/><TextBlock Text="整理喜欢的作品，公开与私密随时切换" Foreground="#667A90" Margin="0,5,0,0"/></StackPanel>
   <TextBlock Text="WINDOWS  /  v1.0.4" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#667A90" FontSize="12"/>
  </Grid>
  <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,14">
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel VerticalAlignment="Center"><TextBlock x:Name="LoginStatus" Text="● 未登录" Foreground="#53677D" FontWeight="SemiBold"/><TextBlock Text="在官方网页完成登录，登录状态保存在本机" Foreground="#667A90" FontSize="12" Margin="0,4,0,0"/></StackPanel>
    <Button Grid.Column="1" x:Name="LoginButton" Content="登录 / 切换账号" Click="Login_Click"/>
    <Button Grid.Column="2" x:Name="CheckLoginButton" Content="检查登录" Click="CheckLogin_Click" IsEnabled="False" Margin="0"/>
   </Grid>
  </Border>
  <Grid Grid.Row="2" Margin="0,0,0,14">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.9*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Style="{StaticResource Card}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock Text="作品 ID 或链接" FontWeight="SemiBold" Foreground="#24374C" Margin="0,0,0,10"/>
     <TextBox Grid.Row="1" x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="90" FontSize="14" ToolTip="粘贴纯数字 ID、作品 URL，或带 pixiv id 标注的文本"/>
     <Grid Grid.Row="2" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Button x:Name="ParseButton" Content="解析 ID" Click="Parse_Click" Padding="14,6"/>
      <Button Grid.Column="1" x:Name="ClearButton" Content="清空" Click="Clear_Click" Padding="14,6"/>
      <TextBlock Grid.Column="2" x:Name="ParseStatus" Text="支持插画 / 漫画；自动去重" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#667A90" FontSize="12" TextWrapping="Wrap"/>
     </Grid>
    </Grid>
   </Border>
   <Border Grid.Column="2" Style="{StaticResource Card}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="本次作品与结果" FontWeight="SemiBold" Foreground="#24374C" Margin="0,0,0,10"/>
     <ListBox Grid.Row="1" x:Name="IdList" BorderThickness="0" Background="#F5EEE2" FontSize="13" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock Text="收藏模式" Margin="0,0,18,0" Foreground="#24374C"/>
      <RadioButton x:Name="PublicMode" GroupName="BookmarkMode" Content="公开收藏" IsChecked="True" Margin="0,0,22,0"/>
      <RadioButton x:Name="PrivateMode" GroupName="BookmarkMode" Content="私密收藏"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal">
      <Button x:Name="BookmarkButton" Content="开始批量收藏" Style="{StaticResource PrimaryButton}" Click="Bookmark_Click" IsEnabled="False"/>
      <Button x:Name="RemoveButton" Content="批量取消收藏" Click="Remove_Click" IsEnabled="False"/>
      <Button x:Name="StopButton" Content="停止任务" Click="Stop_Click" IsEnabled="False" Margin="0"/>
     </StackPanel>
    </Grid>
    <TextBlock Grid.Row="1" Text="模式不同：先取消，再重新收藏；模式相同自动跳过。停止会等待当前作品处理结束。" Foreground="#667A90" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"/>
   </Grid>
  </Border>
  <Border Grid.Row="4" Style="{StaticResource Card}">
   <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,10"><TextBlock Text="任务日志" FontWeight="SemiBold" Foreground="#24374C"/><TextBlock x:Name="LogFileStatus" Text="日志自动保存在本机" HorizontalAlignment="Right" Foreground="#667A90" FontSize="12"/></Grid>
    <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#F5EEE2" FontSize="13"/>
   </Grid>
  </Border>
  <Grid Grid.Row="5" Margin="0,14,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <ProgressBar x:Name="TaskProgress" Height="5" Minimum="0" Maximum="1" Foreground="{StaticResource Accent}" Background="#DDCEB8"/>
   <TextBlock Grid.Row="1" x:Name="Summary" Text="等待登录并输入作品" Foreground="#53677D" Margin="0,8,0,0"/>
  </Grid>
 </Grid>
  <!-- Both wallpaper controls remain available while the interface is hidden. -->
  <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,22,0,0" Panel.ZIndex="4">
   <Button x:Name="ModeSwitchButton" Content="换回新版" Click="ModeSwitch_Click" Visibility="Collapsed" FontSize="16" Margin="0,0,12,0" />
   <Button x:Name="WallpaperButton" Content="看看兽娘麻麻˃ 𖥦 ˂ " Click="Wallpaper_Click" Style="{StaticResource PrimaryButton}" FontFamily="Microsoft YaHei UI, Segoe UI Historic" FontSize="16" Margin="0,0,12,0" />
   <Button x:Name="NextWallpaperButton" Content="切换壁纸（1/2）" Click="NextWallpaper_Click" FontSize="16" Margin="0" />
  </StackPanel>
 </Grid>
</Window>
